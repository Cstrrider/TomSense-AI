-- Queries against the local store — the SOURCE OF TRUTH (spec §5).
--
-- The SCHEMA is not here. `deriveSchemaFromMigrations` is on, so the tables
-- are defined by the numbered `.sqm` migrations in this directory and a fresh
-- install is those migrations replayed in order. That is deliberate: the app
-- is already installed on a device with real conversations on it, and making
-- the upgrade path authoritative is the only way a new install and an upgraded
-- one are guaranteed to end up with the same database.
--
-- The local schema mirrors D1's with one addition per table: `dirty`. A row is
-- dirty when it has local changes the edge has not acknowledged. That single
-- flag is what makes the app work offline — writes land here immediately, the
-- UI renders from here, and the sync engine drains dirty rows when it can.

-- ─── queries ────────────────────────────────────────────────────────────────

-- Pinned first, then most recent — the same order stable settled on
-- (`ORDER BY is_pinned DESC, updated_at DESC`, backend/app/db.py:407).
conversationList:
SELECT * FROM conversation WHERE deleted = 0
ORDER BY pinned DESC, updated_at DESC;

conversationById:
SELECT * FROM conversation WHERE id = ?;

messagesFor:
SELECT * FROM message WHERE conv_id = ? AND deleted = 0 ORDER BY created_at;

messageById:
SELECT * FROM message WHERE id = ?;

upsertConversation:
INSERT OR REPLACE INTO conversation(
  id, project_id, title, model, system_prompt, pinned, share_token,
  created_at, updated_at, deleted, lamport, device_id, dirty
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertMessage:
INSERT OR REPLACE INTO message(
  id, conv_id, role, content, encrypted, reasoning, tool_calls, attachments,
  created_at, deleted, lamport, device_id, dirty
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertConversationTimestamp:
UPDATE conversation SET updated_at = ?, dirty = 1 WHERE id = ?;

-- ─── chat management ────────────────────────────────────────────────────────
--
-- Every one of these takes the caller's freshly bumped lamport and sets
-- `dirty = 1`. A mutation that forgets either is invisible to sync: it shows
-- correctly on this device and never reaches any other, which is close to
-- impossible to notice locally and the reason they all look alike.
--
-- `updated_at` is deliberately NOT touched by pin — pinning a year-old chat
-- should not make it look freshly used once it is unpinned again.

renameConversation:
UPDATE conversation SET title = ?, updated_at = ?, lamport = ?, dirty = 1 WHERE id = ?;

setConversationPinned:
UPDATE conversation SET pinned = ?, lamport = ?, dirty = 1 WHERE id = ?;

setConversationProject:
UPDATE conversation SET project_id = ?, updated_at = ?, lamport = ?, dirty = 1 WHERE id = ?;

setConversationSystemPrompt:
UPDATE conversation SET system_prompt = ?, updated_at = ?, lamport = ?, dirty = 1 WHERE id = ?;

setConversationModel:
UPDATE conversation SET model = ?, updated_at = ?, lamport = ?, dirty = 1 WHERE id = ?;

-- Written from the edge's response after a link is minted or revoked.
setConversationShareToken:
UPDATE conversation SET share_token = ?, lamport = ?, dirty = 1 WHERE id = ?;

-- Tombstone, never a real DELETE: a row that simply vanishes locally is
-- indistinguishable from one this device has not pulled yet, so the next sync
-- would cheerfully restore it.
tombstoneConversation:
UPDATE conversation SET deleted = 1, lamport = ?, dirty = 1 WHERE id = ?;

-- Messages carry their own tombstones so other devices drop the bodies too,
-- rather than keeping orphans attached to a deleted conversation.
tombstoneMessagesFor:
UPDATE message SET deleted = 1, lamport = ?, dirty = 1 WHERE conv_id = ?;

-- ─── search ─────────────────────────────────────────────────────────────────
--
-- Only the TITLE search lives here. Everything touching `message_fts` is in
-- MessageSearch.kt as raw SQL, because SQLDelight 2.0.2 cannot generate code
-- against an FTS5 table at all — its SQLite dialect ships no fts5 module, so
-- a virtual table's columns have no types. Selecting one fails to compile, and
-- merely referencing the table in a subquery sends the generator into infinite
-- recursion (StackOverflowError). The table itself is fine: it is created in
-- 1.sqm, which SQLDelight passes through without needing to type it.
--
-- Titles are short and few, so LIKE genuinely is the right tool here — a
-- second index to maintain would cost more than it saves.
searchConversationTitles:
SELECT * FROM conversation
WHERE deleted = 0 AND title LIKE ('%' || ? || '%')
ORDER BY pinned DESC, updated_at DESC
LIMIT ?;

-- Fallback for devices whose SQLite has no usable FTS module at all. Slower
-- than the index on a large history, but it touches only real tables, so it
-- is compile-checked and works everywhere. See MessageSearch.isAvailable.
searchMessagesLike:
SELECT m.id AS msgId, m.conv_id AS convId, c.title AS title,
       m.role AS role, m.created_at AS createdAt, m.content AS content
FROM message m
JOIN conversation c ON c.id = m.conv_id
WHERE m.deleted = 0 AND c.deleted = 0
  AND m.content LIKE ('%' || ? || '%')
ORDER BY m.created_at DESC
LIMIT ?;

-- Streaming writes bypass the dirty flag deliberately; see
-- ChatRepository.updateStreamingContent for why.
updateMessageContent:
UPDATE message SET content = ? WHERE id = ?;

updateMessageReasoning:
UPDATE message SET reasoning = ? WHERE id = ?;

-- Regenerate empties the existing row rather than inserting a new one: the
-- message keeps its id, so the replaced answer does not appear twice on other
-- devices after sync.
resetMessage:
UPDATE message SET content = '', reasoning = NULL WHERE id = ?;

markMessageDirty:
UPDATE message SET lamport = ?, dirty = 1 WHERE id = ?;

dirtyConversations:
SELECT * FROM conversation WHERE dirty = 1 LIMIT ?;

dirtyMessages:
SELECT * FROM message WHERE dirty = 1 LIMIT ?;

clearConversationDirty:
UPDATE conversation SET dirty = 0 WHERE id = ? AND lamport <= ?;

clearMessageDirty:
UPDATE message SET dirty = 0 WHERE id = ? AND lamport <= ?;

syncState:
SELECT * FROM sync_state WHERE id = 0;

initSyncState:
INSERT OR IGNORE INTO sync_state(id, device_id, cursor, lamport) VALUES (0, ?, 0, 0);

setCursor:
UPDATE sync_state SET cursor = ? WHERE id = 0;

bumpLamport:
UPDATE sync_state SET lamport = lamport + 1 WHERE id = 0;

-- Remote rows can carry a lamport ahead of ours. Adopting the max keeps this
-- device's clock monotonic and ahead of anything it has observed, which is
-- what makes subsequent local edits win as the user expects.
raiseLamport:
UPDATE sync_state SET lamport = MAX(lamport, ?) WHERE id = 0;
